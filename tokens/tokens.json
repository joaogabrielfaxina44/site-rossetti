{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "canvas": {
      "paper": { "$value": "#08090c", "$type": "color", "$description": "Obsidian dark canvas" }
    },
    "text": {
      "ink": { "$value": "#f0f1f4", "$type": "color", "$description": "High-contrast primary ink" },
      "grey": { "$value": "#9c9da7", "$type": "color", "$description": "Technical muted grey" },
      "slate": { "$value": "#adb4be", "$type": "color", "$description": "Subtle paragraph slate" },
      "caption": { "$value": "#7f8996", "$type": "color", "$description": "Micro-label caption grey" }
    },
    "accent": {
      "blue": { "$value": "#5a68c9", "$type": "color", "$description": "Electric indigo brand accent" },
      "focus": { "$value": "#bac0ff", "$type": "color", "$description": "Accessible keyboard focus ring" },
      "signal": { "$value": "#b8ffcc", "$type": "color", "$description": "Active live phosphor status indicator" },
      "chrome": { "$value": "#edf4fd", "$type": "color", "$description": "Polished titanium ribbon specular highlight" }
    },
    "surface": {
      "window": { "$value": "linear-gradient(145deg, rgba(20,26,33,0.95), rgba(12,17,23,0.97))", "$type": "gradient", "$description": "Spatial OS window surface" },
      "island": { "$value": "#18191cde", "$type": "color", "$description": "Frosted navigation island surface" },
      "dialog": { "$value": "#101720", "$type": "color", "$description": "Modal drawer night surface" },
      "dock": { "$value": "#111821ed", "$type": "color", "$description": "Bottom dock frosted surface" },
      "rail": { "$value": "#10161ee8", "$type": "color", "$description": "Sidebar launcher rail surface" },
      "panel": { "$value": "#0d1722ab", "$type": "color", "$description": "Frosted workspace panel" }
    },
    "border": {
      "line": { "$value": "#ffffff21", "$type": "color", "$description": "Subtle divider line" },
      "hairline": { "$value": "#cbd4df2b", "$type": "color", "$description": "Glass hairline rim" },
      "card": { "$value": "#8da8cb63", "$type": "color", "$description": "Card contour perimeter" },
      "gaze": { "$value": "#dceaffb3", "$type": "color", "$description": "Gaze highlight glow perimeter" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "$value": "Arial, Helvetica, sans-serif", "$type": "fontFamily" },
      "serif": { "$value": "Georgia, 'Times New Roman', serif", "$type": "fontFamily" },
      "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace", "$type": "fontFamily" }
    },
    "fontWeight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    },
    "fontSize": {
      "micro": { "$value": "10px", "$type": "dimension" },
      "eyebrow": { "$value": "12px", "$type": "dimension" },
      "body": { "$value": "16px", "$type": "dimension" },
      "bodyLarge": { "$value": "20px", "$type": "dimension" },
      "feature": { "$value": "24px", "$type": "dimension" },
      "heading": { "$value": "36px", "$type": "dimension" },
      "display": { "$value": "64px", "$type": "dimension" }
    }
  },
  "borderRadius": {
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "pill": { "$value": "30px", "$type": "dimension" },
    "window": { "$value": "36px", "$type": "dimension" }
  },
  "elevation": {
    "card": { "$value": "0 8px 20px rgba(0, 0, 0, 0.2)", "$type": "shadow" },
    "dock": { "$value": "0 12px 38px rgba(0, 0, 0, 0.45)", "$type": "shadow" },
    "window": { "$value": "0 30px 86px rgba(0, 0, 0, 0.55)", "$type": "shadow" },
    "gaze": { "$value": "0 0 26px rgba(151, 187, 255, 0.45)", "$type": "shadow" }
  }
}
